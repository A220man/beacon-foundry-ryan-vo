# Beacon Foundry Configuration
# Copy this file to .env and adjust variables as needed.

# Application Environment
ENVIRONMENT=development
PORT=8000
DATABASE_URL=sqlite:///./beacon_foundry.db

# Authentication Mode (local_demo or oidc)
AUTH_MODE=local_demo

# OIDC Keycloak Settings (Required when AUTH_MODE=oidc)
KEYCLOAK_URL=http://127.0.0.1:8080
KEYCLOAK_REALM=beacon-realm
KEYCLOAK_CLIENT_ID=beacon-client
KEYCLOAK_CLIENT_SECRET=
OIDC_DISCOVERY_URL=

# Advisory LLM Configuration (Keys only server-side, never logged)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
